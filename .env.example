# Used only by the local HTTP server. Provider credentials are registered per source
# and must have read-only scopes.
PORT=3000
# Optional local-only model reasoning. Leave disabled in shared/production
# environments until an operator deliberately configures a provider. These are
# server settings; never return the base URL or model configuration to clients.
# OBSERVATORY_AI_ENABLED=false
# OBSERVATORY_AI_PROVIDER=ollama
# OBSERVATORY_AI_MODEL=qwen2.5:7b
# OBSERVATORY_AI_BASE_URL=http://127.0.0.1:11434
# OBSERVATORY_AI_TIMEOUT_MS=20000
# Optional locally. Required with an HTTPS endpoint when NODE_ENV=production.
# OBSERVATORY_AI_AUTH_MODE=bearer
# OBSERVATORY_AI_AUTH_TOKEN=
# Separate browser feature gate. The Assistant page is hidden and direct access
# returns a controlled unavailable response unless this is explicitly true.
# OBSERVATORY_ASSISTANT_UI_ENABLED=false
# Provider-managed Vercel/Neon pooled connection. Do not add a duplicate credential.
# POSTGRES_URL=
# Provider-managed Neon direct connection; used only by the guarded migration runner.
# POSTGRES_URL_NON_POOLING=
# Required in production for source configuration encryption (32-byte base64 key).
# OBSERVATORY_CONFIG_KEY=
# Required for all production administration endpoints.
# OBSERVATORY_OPERATOR_TOKEN=
# Required for authenticated remote MCP read access. This is deliberately
# separate from OBSERVATORY_OPERATOR_TOKEN and grants no administration access.
# OBSERVATORY_MCP_READ_TOKEN=replace-with-a-long-random-read-only-token
# OAuth/OIDC resource-server configuration for ChatGPT MCP. These are
# server-only deployment settings; the provider issuer and JWKS endpoint are
# public identifiers, while the allowed subject is an access-control allowlist.
# The audience must exactly equal OBSERVATORY_MCP_PUBLIC_ORIGIN.
# OBSERVATORY_MCP_PUBLIC_ORIGIN=https://the-observatory-blue.vercel.app
# OBSERVATORY_OAUTH_ISSUER=https://YOUR_AUTH0_TENANT/
# OBSERVATORY_OAUTH_AUDIENCE=https://the-observatory-blue.vercel.app
# Optional when the provider uses ISSUER/.well-known/jwks.json.
# OBSERVATORY_OAUTH_JWKS_URI=https://YOUR_AUTH0_TENANT/.well-known/jwks.json
# OBSERVATORY_OAUTH_ALLOWED_SUBJECT=auth0|YOUR_OBSERVATORY_OWNER_SUBJECT
# Explicit one-time guard required before running a production migration.
# OBSERVATORY_MIGRATE_PRODUCTION=true
